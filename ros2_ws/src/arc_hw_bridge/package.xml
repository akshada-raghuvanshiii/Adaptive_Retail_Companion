<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arc_hw_bridge</name>
  <version>0.1.0</version>
  <description>ARC motor bridge: /cmd_vel to an Arduino Uno (arc_motor_bridge.ino) driving the real wheels, with Hall-sensor wheel speed back on /arc_hw/wheels. Publishes no /odom or TF.</description>
  <maintainer email="akshada-raghuvanshi@todo.todo">akshada-raghuvanshi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
