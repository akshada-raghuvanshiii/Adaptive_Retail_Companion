<?xml version="1.0"?>
<sdf version="1.9">
  <model name="person">

    <!--
      Stylized visualization person.
      Approximate total height: 0.60 m.
      Designed for clear visualization beside TurtleBot3 Burger.
    -->

    <static>false</static>

    <link name="body">

